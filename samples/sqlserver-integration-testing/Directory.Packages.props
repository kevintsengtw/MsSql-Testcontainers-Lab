<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- src -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- tests -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <!--
      明確使用 MTP v2，不再引用 VSTest 的 Test SDK 與 adapter。
      xUnit v3 測試專案是獨立執行檔，csproj 需要 OutputType=Exe。
      dotnet test 由 repository 根目錄的 global.json 指定 MTP runner。
    -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
  </ItemGroup>
  <!-- 將仍由上游引用舊版的間接相依套件固定為最新穩定版。 -->
  <ItemGroup>
    <PackageVersion Include="Fare" Version="2.2.2" />
    <PackageVersion Include="Microsoft.ApplicationInsights" Version="3.2.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Bcl.Cryptography" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.91.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="7.0.4" />
    <PackageVersion Include="NETStandard.Library" Version="2.0.3" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.Abstractions" Version="1.1.2" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.FileSystem" Version="1.1.2" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="System.Memory.Data" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.13" />
  </ItemGroup>
</Project>
